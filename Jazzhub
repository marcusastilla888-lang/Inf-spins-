-- ========== HELPER FUNCTIONS (MULTI-TARGET MATCHING) ==========
-- Parsed string separated by commas into a table of lowercase trimmed strings
local function parseTargets(rawText)
	local targets = {}
	if not rawText or rawText:gsub("%s+", "") == "" then
		return targets
	end
	for name in string.gmatch(rawText, "[^,]+") do
		local cleaned = name:gsub("^%s+", ""):gsub("%s+$", ""):lower()
		if cleaned ~= "" then
			table.insert(targets, cleaned)
		end
	end
	return targets
end

-- Checks if the current name matches ANY of the target names
local function matchesAnyTarget(currentName, rawTargetText)
	if not currentName then return false end
	local targets = parseTargets(rawTargetText)
	if #targets == 0 then return false end

	local currentLower = currentName:lower()
	for _, target in ipairs(targets) do
		if currentLower == target then
			return true
		end
	end
	return false
end

